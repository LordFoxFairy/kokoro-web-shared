{
  "name": "@kokoro/i18n",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LordFoxFairy/kokoro-web-shared.git",
    "directory": "packages/i18n"
  },
  "description": "Framework-free locale negotiation, interpolation and fallback engine.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.cnb.cool/awesomeaicode/npm/registry/-/packages/",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "test": "vitest run test",
    "test:integration": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "coverage": "vitest run --coverage --no-file-parallelism"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.62.1",
    "vitest": "^2.1.9"
  }
}
